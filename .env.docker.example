# Copy to .env and replace all four placeholder secrets before starting.
DJANGO_SECRET_KEY=replace-with-a-generated-django-secret
DB_PASSWORD=replace-with-a-generated-database-password
DB_ROOT_PASSWORD=replace-with-a-different-generated-root-password
APPROVAL_API_KEY=replace-with-a-generated-service-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
APPROVAL_API_URL=http://127.0.0.1:8000/api/approved/
# Console mode prints email in logs. Use SMTP settings to deliver real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-provider-username
EMAIL_HOST_PASSWORD=replace-with-provider-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=newsdesk@example.com
