# Copy to .env beside manage.py and replace the mock values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=newsdesk
DB_USER=newsdesk
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=sender@example.com
SITE_URL=http://127.0.0.1:8000
APPROVAL_API_URL=http://127.0.0.1:8000/api/approved/
APPROVAL_API_KEY=replace-with-a-generated-service-key
